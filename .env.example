# Copy this to .env (gitignored) and fill in real values.
# docker-compose.yml reads .env automatically and substitutes ${VAR} references -
# see documentations/guides/google-maps-setup.md for how to obtain each of these.

# Signs/verifies driver JWTs - generate a real random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# Google sign-in (optional - leave empty to disable, see documentations/guides/google-maps-setup.md)
GOOGLE_CLIENT_ID=

# Email verification / password reset (optional - leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hvr.local
